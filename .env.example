# Local development placeholders only. Keep these credentials in sync.
POSTGRES_USER=mano_local
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=mano_local
# "postgres" is the database hostname within Docker Compose.
DATABASE_URL=postgresql+psycopg://mano_local:replace_with_local_password@postgres:5432/mano_local
# Optional: existing extraction uses deterministic fallback without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Optional: needed only when using the existing ElevenLabs transcription endpoint.
ELEVENLABS_API_KEY=
SEED_DEMO_BUSINESS=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Browser-facing backend URL; embedded when the frontend image is built.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
